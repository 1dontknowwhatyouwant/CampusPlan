# 로컬 개발용 설정 템플릿. 복사해서 .env 로 만들고 값을 채웁니다. (.env 는 Git 에 올리지 않습니다)
# Docker MySQL 컨테이너를 만들 때 쓰는 root 비밀번호
MYSQL_ROOT_PASSWORD=change-me
# 백엔드가 읽는 DB 접속 정보 (값에 & 가 있으므로 작은따옴표로 감쌉니다)
DB_URL='jdbc:mysql://127.0.0.1:3306/campusplan?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul'
DB_USER=root
DB_PASSWORD=change-me
